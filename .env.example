# Application
APP_ENV=development

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=event_platform
POSTGRES_URL=postgres://postgres:postgres@localhost:5432/event_platform?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# MongoDB
MONGODB_URI=mongodb://mongo:mongo@localhost:27017
MONGODB_DATABASE=event_platform

# Kafka
KAFKA_BROKERS=localhost:9092

# Auth
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRY=24h

# Services ports
COLLECTOR_HTTP_PORT=8081
ANALYTICS_HTTP_PORT=8082
PREDICTION_HTTP_PORT=8083
PREDICTION_GRPC_PORT=9093
WEBSOCKET_HTTP_PORT=8084
QUERY_HTTP_PORT=8085
QUERY_GRPC_PORT=9095
AUTH_HTTP_PORT=8086
ALERT_HTTP_PORT=8087
